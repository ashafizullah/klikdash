<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.0 belum memuat root Let's Encrypt (ISRG), padahal everyayah.com (audio murattal) dan unduhan rilis GitHub
     memakainya. Root disertakan di sini; di Android yang lebih baru isinya sama dengan bawaan sistem. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
    <!-- Uji akun KlikBeam di emulator: server di Mac lewat http://10.0.2.2:3110 (Account.applyExtras). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

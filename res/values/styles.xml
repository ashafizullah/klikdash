<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0B0B0A</color>

    <style name="KlikDash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Tema SIANG (lihat Theme.java): dialog dan widget bawaan bergaya terang. Warna jendela diatur Theme.apply. -->
    <style name="KlikDash.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>

    <string name="settings_home_title">TAMPILAN UTAMA</string>
    <string name="settings_home_on">KlikDash sedang menjadi tampilan utama headunit. Kembali ke launcher bawaan kapan saja; KlikDash tetap terpasang.</string>
    <string name="settings_home_off">Launcher bawaan masih menjadi tampilan utama. Jadikan KlikDash tampilan utama agar muncul setiap headunit menyala.</string>
    <string name="settings_home_restore">LAUNCHER BAWAAN</string>
    <string name="settings_home_make">JADIKAN UTAMA</string>

    <string name="settings_hijri_title">TANGGAL HIJRIAH</string>
    <string name="settings_hijri_desc">Hari ini %1$s. Dihitung dengan kalender Umm al-Qura, yang bisa selisih sehari dari kalender Kemenag. Geser per hari bila hasil rukyat berbeda.</string>

    <string name="settings_lang_title">BAHASA</string>
    <string name="settings_lang_desc">Bahasa tampilan KlikDash. Asisten AI punya pengaturan bahasa sendiri di tab Asisten AI.</string>

    <string name="settings_theme_title">TEMA</string>

    <string name="settings_tiles_title">JUMLAH PINTASAN</string>
    <string name="settings_tiles_desc">Pintasan di home, termasuk SEMUA. Makin sedikit, makin besar jam dan jadwal sholat di kiri, juga pintasan, ikon, dan tulisannya. Pintasan yang tidak tampil tetap tersimpan dan muncul lagi bila jumlahnya ditambah.</string>

    <string name="settings_welcome_title">SAMBUTAN</string>
    <string name="settings_welcome_desc">Tampil di home saat headunit menyala. %1$s</string>
    <string name="settings_welcome_now_off">Sekarang dimatikan.</string>
    <string name="settings_welcome_now_custom">Sekarang memakai teks Anda sendiri.</string>
    <string name="settings_welcome_now_default">Sekarang doa keluar rumah (bawaan).</string>
    <string name="settings_welcome_default">BAWAAN</string>
    <string name="settings_welcome_custom">CUSTOM</string>
    <string name="settings_welcome_view">LIHAT</string>
    <string name="settings_welcome_disabled">Sambutan sedang dimatikan</string>
    <string name="settings_welcome_dialog">Sambutan sendiri</string>
    <string name="settings_welcome_f_title">JUDUL</string>
    <string name="settings_welcome_f_title_hint">mis. Doa naik kendaraan</string>
    <string name="settings_welcome_f_arab">TEKS ARAB (OPSIONAL)</string>
    <string name="settings_welcome_f_latin">BACAAN LATIN (OPSIONAL)</string>
    <string name="settings_welcome_f_text">ARTI ATAU PESAN</string>
    <string name="settings_welcome_f_text_hint">mis. Hati-hati di jalan, jaga jarak aman.</string>
    <string name="settings_welcome_need_text">Isi teks Arab atau pesan</string>

    <string name="settings_prayer_title">PENGINGAT SHOLAT</string>
    <string name="settings_prayer_desc">Notifikasi saat masuk waktu Subuh, Dzuhur, Ashar, Maghrib, dan Isya, tanpa adzan. Muncul juga di atas aplikasi lain seperti Maps.</string>
    <string name="settings_prayer_test">COBA</string>

    <string name="settings_tiles_reset_title">PINTASAN HOME</string>
    <string name="settings_tiles_reset_desc">Tekan lama pintasan di home untuk mengganti atau memindahkan aplikasinya. Atur ulang mengembalikan susunan bawaan KlikDash.</string>
    <string name="settings_tiles_reset">ATUR ULANG</string>
    <string name="settings_tiles_reset_confirm">Kembalikan semua pintasan home ke susunan bawaan?</string>
    <string name="settings_tiles_reset_button">Atur ulang</string>
    <string name="settings_tiles_reset_done">Pintasan dikembalikan ke bawaan</string>

    <string name="settings_system_title">PENGATURAN SISTEM</string>
    <string name="settings_system_desc">Wi-Fi, Bluetooth, suara, layar, dan opsi pengembang ada di pengaturan Android headunit.</string>
    <string name="settings_system_open">BUKA</string>

    <string name="settings_about_title">TENTANG</string>
    <string name="settings_about_desc">KlikDash %1$s — launcher ringan untuk headunit Android. Sumber terbuka (MIT) di github.com/ashafizullah/klikdash. Ayat Al-Qur\'an pada dzikir: Tanzil (tanzil.net).</string>


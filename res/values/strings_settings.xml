    <string name="settings_home_title">TAMPILAN UTAMA</string>
    <string name="settings_home_on">KlikDash sedang menjadi tampilan utama headunit. Kembali ke launcher bawaan kapan saja; KlikDash tetap terpasang.</string>
    <string name="settings_home_off">Launcher bawaan masih menjadi tampilan utama. Jadikan KlikDash tampilan utama agar muncul setiap headunit menyala.</string>
    <string name="settings_home_restore">LAUNCHER BAWAAN</string>
    <string name="settings_home_make">JADIKAN UTAMA</string>

    <string name="settings_clock_title">FORMAT JAM</string>
    <string name="settings_clock_desc">Jam di home, jadwal sholat, dan pengingat sholat. Format 12 jam menampilkan AM/PM di samping jam.</string>
    <string name="settings_clock_24">24 JAM</string>
    <string name="settings_clock_12">12 JAM</string>
    <string name="settings_orient_title">ORIENTASI LAYAR</string>
    <string name="settings_orient_desc">Otomatis mengikuti rotasi headunit. Pilih MENDATAR bila layar jadi tegak setelah KlikDash dijadikan tampilan utama: panel headunit itu aslinya tegak dan launcher bawaannya yang memaksa mendatar. Berlaku untuk semua layar KlikDash.</string>
    <string name="settings_orient_auto">OTOMATIS</string>
    <string name="settings_orient_landscape">MENDATAR</string>
    <string name="settings_orient_portrait">TEGAK</string>
    <string name="settings_method_title">JADWAL SHOLAT</string>
    <string name="settings_method_desc">Otomatis: JAKIM bila zona waktu headunit Malaysia, selain itu Kemenag RI. Sekarang dihitung dengan %1$s.</string>
    <string name="settings_method_auto">OTOMATIS</string>
    <string name="settings_method_kemenag">KEMENAG</string>
    <string name="settings_method_jakim">JAKIM</string>
    <string name="settings_method_kemenag_name">Kemenag RI (Subuh 20°, Isya 18°)</string>
    <string name="settings_method_jakim_name">JAKIM Malaysia (Subuh 18°, Isyak 18°)</string>
    <string name="settings_hijri_title">TANGGAL HIJRIAH</string>
    <string name="settings_hijri_desc">Hari ini %1$s. Dihitung dengan kalender Umm al-Qura, yang bisa selisih sehari dari kalender Kemenag. Geser per hari bila hasil rukyat berbeda.</string>

    <string name="settings_lang_title">BAHASA</string>
    <string name="settings_lang_desc">Bahasa tampilan KlikDash. Asisten AI punya pengaturan bahasa sendiri di tab Asisten AI.</string>

    <string name="settings_theme_title">TEMA</string>
    <string name="settings_theme_auto_title">TEMA OTOMATIS</string>
    <string name="settings_theme_auto_desc">Berganti sendiri antara tema siang dan tema malam mengikuti matahari di lokasi headunit. Hari ini siang dari %1$s sampai %2$s.</string>
    <string name="settings_theme_day_title">TEMA SIANG</string>
    <string name="settings_theme_day_desc">Dipakai dari matahari terbit (%1$s) sampai terbenam (%2$s).</string>
    <string name="settings_theme_night_title">TEMA MALAM</string>
    <string name="settings_theme_night_desc">Dipakai dari matahari terbenam (%1$s) sampai terbit lagi (%2$s).</string>

    <string name="settings_tiles_title">JUMLAH PINTASAN</string>
    <string name="settings_tiles_desc">Pintasan di home, termasuk SEMUA. Makin sedikit, makin besar jam dan jadwal sholat di kiri, juga pintasan, ikon, dan tulisannya. Pintasan yang tidak tampil tetap tersimpan dan muncul lagi bila jumlahnya ditambah.</string>

    <string name="settings_saver_title">SCREENSAVER</string>
    <string name="settings_saver_desc">Jam dan tanggal, muncul bila home tidak disentuh sekian menit. Tidak menutupi aplikasi lain seperti Maps dan tidak muncul saat mobil berjalan. Ketuk layar untuk kembali.</string>
    <string name="settings_saver_bg_title">LATAR SCREENSAVER</string>
    <string name="settings_saver_bg_black_desc">Hitam polos, paling nyaman di malam hari.</string>
    <string name="settings_saver_bg_photo_desc">Foto pilihan sendiri, diredupkan sedikit supaya jam tetap terbaca.</string>
    <string name="settings_saver_black">HITAM</string>
    <string name="settings_saver_photo">FOTO</string>
    <string name="settings_saver_change">GANTI FOTO</string>
    <string name="settings_saver_preview">COBA</string>
    <string name="settings_saver_no_picker">Headunit ini tidak punya aplikasi untuk memilih foto</string>
    <string name="settings_saver_saved">Foto screensaver disimpan</string>
    <string name="settings_saver_failed">Foto tidak bisa dibuka. Coba foto lain.</string>


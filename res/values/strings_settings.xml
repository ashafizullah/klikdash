    <string name="settings_prayer_title">PENGINGAT SHOLAT</string>
    <string name="settings_prayer_desc">Notifikasi saat masuk waktu Subuh, Dzuhur, Ashar, Maghrib, dan Isya, tanpa adzan. Muncul juga di atas aplikasi lain seperti Maps.</string>
    <string name="settings_prayer_test">COBA</string>

    <string name="settings_tiles_reset_title">PINTASAN HOME</string>
    <string name="settings_tiles_reset_desc">Tekan lama pintasan di home untuk mengganti atau memindahkan aplikasinya. Atur ulang mengembalikan susunan bawaan KlikDash.</string>

    <string name="settings_on">ON</string>
    <string name="settings_off">OFF</string>

    <string name="settings_home_title">HOME SCREEN</string>
    <string name="settings_home_on">KlikDash is the headunit\'s home screen. You can switch back to the stock launcher at any time; KlikDash stays installed.</string>
    <string name="settings_home_off">The stock launcher is still the home screen. Make KlikDash the home screen so it shows every time the headunit starts.</string>
    <string name="settings_home_restore">STOCK LAUNCHER</string>
    <string name="settings_home_make">MAKE DEFAULT</string>

    <string name="settings_clock_title">CLOCK FORMAT</string>
    <string name="settings_clock_desc">Clock on the home screen, prayer times, and prayer reminders. 12-hour shows AM/PM next to the clock.</string>
    <string name="settings_clock_24">24-HOUR</string>
    <string name="settings_clock_12">12-HOUR</string>
    <string name="settings_orient_title">SCREEN ORIENTATION</string>
    <string name="settings_orient_desc">Auto follows the headunit\'s rotation. Choose LANDSCAPE if the screen turns portrait after KlikDash becomes the home screen: that headunit\'s panel is natively portrait and its stock launcher forces landscape. Applies to every KlikDash screen.</string>
    <string name="settings_orient_auto">AUTO</string>
    <string name="settings_orient_landscape">LANDSCAPE</string>
    <string name="settings_orient_portrait">PORTRAIT</string>
    <string name="settings_method_title">PRAYER TIMES</string>
    <string name="settings_method_desc">Automatic: JAKIM when the headunit\'s time zone is Malaysia, otherwise Kemenag (Indonesia). Now calculated with %1$s.</string>
    <string name="settings_method_auto">AUTO</string>
    <string name="settings_method_kemenag">KEMENAG</string>
    <string name="settings_method_jakim">JAKIM</string>
    <string name="settings_method_kemenag_name">Kemenag, Indonesia (Fajr 20°, Isha 18°)</string>
    <string name="settings_method_jakim_name">JAKIM, Malaysia (Fajr 18°, Isha 18°)</string>
    <string name="settings_hijri_title">HIJRI DATE</string>
    <string name="settings_hijri_desc">Today is %1$s. Calculated with the Umm al-Qura calendar, which can be a day off from the Kemenag calendar. Shift it by a day if the moon sighting differs.</string>

    <string name="settings_lang_title">LANGUAGE</string>
    <string name="settings_lang_desc">KlikDash display language. The AI assistant has its own language setting in the AI Assistant tab.</string>

    <string name="settings_theme_title">THEME</string>
    <string name="settings_theme_auto_title">AUTOMATIC THEME</string>
    <string name="settings_theme_auto_desc">Switches between a day theme and a night theme with the sun at the headunit\'s location. Today, day runs from %1$s to %2$s.</string>
    <string name="settings_theme_day_title">DAY THEME</string>
    <string name="settings_theme_day_desc">Used from sunrise (%1$s) to sunset (%2$s).</string>
    <string name="settings_theme_night_title">NIGHT THEME</string>
    <string name="settings_theme_night_desc">Used from sunset (%1$s) until sunrise (%2$s).</string>

    <string name="settings_tiles_title">NUMBER OF SHORTCUTS</string>
    <string name="settings_tiles_desc">Shortcuts on the home screen, including ALL. Fewer shortcuts make the clock, prayer times, shortcuts, icons and labels bigger. Hidden shortcuts are kept and come back when you raise the number.</string>

    <string name="settings_saver_title">SCREENSAVER</string>
    <string name="settings_saver_desc">The clock and date, shown when the home screen has not been touched for 30 seconds or the chosen minutes. Never covers other apps such as Maps and never appears while driving. Tap the screen to go back.</string>
    <string name="settings_saver_sec">%1$d SEC</string>
    <string name="settings_saver_sec_long">%1$d SEC</string>
    <string name="settings_saver_min_long">%1$d MIN</string>
    <string name="settings_saver_bg_title">SCREENSAVER BACKGROUND</string>
    <string name="settings_saver_bg_black_desc">Plain black, easiest on the eyes at night.</string>
    <string name="settings_saver_bg_photo_desc">A photo of your choice, dimmed a little so the clock stays readable.</string>
    <string name="settings_saver_black">BLACK</string>
    <string name="settings_saver_photo">PHOTO</string>
    <string name="settings_saver_change">CHANGE PHOTO</string>
    <string name="settings_saver_preview">TRY</string>
    <string name="settings_saver_no_picker">This headunit has no app for picking photos</string>
    <string name="settings_saver_saved">Screensaver photo saved</string>
    <string name="settings_saver_failed">The photo could not be opened. Try another one.</string>

    <string name="settings_welcome_title">WELCOME</string>
    <string name="settings_welcome_desc">Shown on the home screen when the headunit starts. %1$s</string>
    <string name="settings_welcome_now_off">Currently off.</string>
    <string name="settings_welcome_now_custom">Currently using your own text.</string>
    <string name="settings_welcome_now_default">Currently the prayer for leaving home (default).</string>
    <string name="settings_welcome_default">DEFAULT</string>
    <string name="settings_welcome_custom">CUSTOM</string>
    <string name="settings_welcome_view">VIEW</string>
    <string name="settings_welcome_disabled">The welcome screen is off</string>
    <string name="settings_welcome_dialog">Custom welcome</string>
    <string name="settings_welcome_f_title">TITLE</string>
    <string name="settings_welcome_f_title_hint">e.g. Prayer for riding a vehicle</string>
    <string name="settings_welcome_f_arab">ARABIC TEXT (OPTIONAL)</string>
    <string name="settings_welcome_f_latin">TRANSLITERATION (OPTIONAL)</string>
    <string name="settings_welcome_f_text">MEANING OR MESSAGE</string>
    <string name="settings_welcome_f_text_hint">e.g. Drive safely and keep your distance.</string>
    <string name="settings_welcome_need_text">Fill in the Arabic text or a message</string>

    <string name="settings_prayer_title">PRAYER REMINDER</string>
    <string name="settings_prayer_desc">A notification when Fajr, Dhuhr, Asr, Maghrib and Isha begin, without the adhan. Also shown on top of other apps such as Maps.</string>
    <string name="settings_prayer_test">TEST</string>

    <string name="settings_tiles_reset_title">HOME SHORTCUTS</string>
    <string name="settings_tiles_reset_desc">Long-press a shortcut on the home screen to change or move its app. Reset restores the KlikDash default layout.</string>
    <string name="settings_tiles_reset">RESET</string>
    <string name="settings_tiles_reset_confirm">Restore all home shortcuts to the default layout?</string>
    <string name="settings_tiles_reset_button">Reset</string>
    <string name="settings_tiles_reset_done">Shortcuts restored to default</string>

    <string name="settings_hidden_title">HIDDEN APPS</string>
    <string name="settings_hidden_none">None yet. Long-press an icon in All Apps to hide it, e.g. an icon that shows up twice.</string>
    <plurals name="settings_hidden_desc">
        <item quantity="one">%1$d app hidden from All Apps. Long-press an icon in All Apps to hide another.</item>
        <item quantity="other">%1$d apps hidden from All Apps. Long-press an icon in All Apps to hide another.</item>
    </plurals>
    <string name="settings_hidden_show">SHOW</string>
    <string name="settings_hidden_pick">Tap an app to show it again</string>
    <string name="settings_hidden_all">Show all</string>
    <string name="settings_hidden_shown">%1$s is back in All Apps</string>
    <string name="settings_hidden_all_done">All apps are shown again</string>

    <string name="settings_system_title">SYSTEM SETTINGS</string>
    <string name="settings_system_desc">Wi-Fi, Bluetooth, sound, display and developer options are in the headunit\'s Android settings.</string>
    <string name="settings_system_open">OPEN</string>

    <string name="settings_about_title">ABOUT</string>
    <string name="settings_about_desc">KlikDash %1$s — a lightweight launcher for Android headunits. Open source (MIT) at github.com/ashafizullah/klikdash. Qur\'an verses in the dhikr: Tanzil (tanzil.net).</string>

    <string-array name="theme_names">
        <item>AMBER</item>
        <item>EMERALD</item>
        <item>DAY</item>
        <item>GLOSSY</item>
    </string-array>
    <string-array name="theme_desc">
        <item>Warm black with an amber accent, the KlikDash default.</item>
        <item>Greenish black with an emerald green accent.</item>
        <item>Light cream background with dark text, easier to read in bright sunlight.</item>
        <item>Clear glossy glass panels on black, with an ice-blue accent and full-color app icons.</item>
    </string-array>


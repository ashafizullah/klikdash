<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ashafizullah.klikdash">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- adbd lokal (127.0.0.1:5555, lihat Tweaks.java), unduhan Al-Qur'an, asisten AI, dan server BEAM -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Ubin TANYA: perintah suara untuk asisten AI -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pembaruan dari Pengaturan bila ADB lokal tidak tersedia (Android meminta konfirmasi) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Pengingat sholat melayang di atas Maps/Waze; diberikan lewat ADB lokal (PrayerAlarm.allowOverlay). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="KlikDash"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/KlikDash"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security"
        android:hardwareAccelerated="true">

        <activity
            android:name=".HomeActivity"
            android:directBootAware="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuranActivity"
            android:label="@string/app_quran"
            android:icon="@drawable/ic_quran"
            android:taskAffinity="com.ashafizullah.klikdash.quran"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DzikirActivity"
            android:label="@string/app_dzikir"
            android:icon="@drawable/ic_dzikir"
            android:taskAffinity="com.ashafizullah.klikdash.dzikir"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_settings"
            android:taskAffinity="com.ashafizullah.klikdash.settings"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection|fontScale" />

        <activity
            android:name=".AskActivity"
            android:label="@string/app_ask"
            android:icon="@drawable/ic_ask"
            android:taskAffinity="com.ashafizullah.klikdash.ask"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- KlikBeam (BETA): mirror layar iPhone lewat WiFi. Dibuka dari Pengaturan › Launcher › KLIKBEAM, tidak
             tampil di daftar aplikasi selama aplikasi iOS-nya belum tersedia. -->
        <activity
            android:name=".BeamActivity"
            android:label="@string/app_beam"
            android:icon="@drawable/ic_beam"
            android:taskAffinity="com.ashafizullah.klikdash.beam"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection|fontScale" />

        <receiver
            android:name=".PrayerAlarm"
            android:exported="false" />

        <receiver
            android:name=".UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".QuranService"
            android:exported="false" />
    </application>
</manifest>
